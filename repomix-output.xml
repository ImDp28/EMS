<file path="client/src/assets/index.css">
@import url("https://fonts.googleapis.com/css2?family=Fira+Code:wght@300..700&family=Outfit:wght@100..900&display=swap");
@import "tailwindcss";

* {
    font-family: "Outfit", "Inter";
}

@layer utilities {
    /* Card styles */
    .card {
        @apply bg-white rounded-lg border border-slate-200/70;
    }
    .card-hover {
        @apply hover:-translate-y-0.5 transition-all duration-300;
    }

    /* Button styles */
    .btn-primary {
        @apply bg-linear-to-r from-indigo-600 to-indigo-500 text-white px-5 py-2.5 rounded-md text-sm
            hover:from-indigo-700 hover:to-indigo-600 transition-all duration-200 shadow-md shadow-indigo-500/25
            active:scale-[0.98];
    }
    .btn-secondary {
        @apply bg-white text-slate-700 border border-slate-200 px-5 py-2.5 rounded-md text-sm
            hover:bg-slate-50 hover:border-slate-300 transition-all duration-200;
    }

    /* Input, Select, Textarea styles */
    input,
    select,
    textarea {
        @apply w-full px-4 py-2.5 bg-slate-50/50 border border-slate-200 rounded-md
            focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-400
            transition-all duration-200 text-sm placeholder:text-slate-400;
    }

    /* Table styles */
    .table-modern {
        @apply w-full text-left text-sm;
    }
    .table-modern thead {
        @apply text-xs font-semibold text-slate-500 uppercase tracking-wider;
    }
    .table-modern thead th {
        @apply px-6 py-4 bg-slate-50/80;
    }
    .table-modern tbody {
        @apply divide-y divide-slate-100;
    }
    .table-modern tbody tr {
        @apply hover:bg-slate-50/50 transition-colors duration-150;
    }
    .table-modern tbody td {
        @apply px-6 py-4;
    }

    /* Badge styles */
    .badge {
        @apply inline-flex items-center px-2.5 py-1 rounded-md text-xs;
    }
    .badge-success {
        @apply bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/10;
    }
    .badge-warning {
        @apply bg-amber-50 text-amber-700 ring-1 ring-amber-600/10;
    }
    .badge-danger {
        @apply bg-rose-50 text-rose-700 ring-1 ring-rose-600/10;
    }

    /* Page header */
    .page-header {
        @apply mb-8;
    }
    .page-title {
        @apply text-2xl font-medium text-slate-900 tracking-tight;
    }
    .page-subtitle {
        @apply text-slate-500 text-sm mt-1;
    }

    /* Animations */
    .animate-fade-in {
        animation: fadeIn 0.4s ease-out;
    }
    .animate-slide-up {
        animation: slideUp 0.4s ease-out;
    }
}

@keyframes fadeIn {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(12px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Custom scrollbar */
::-webkit-scrollbar {
    width: 6px;
}
::-webkit-scrollbar-track {
    @apply bg-transparent;
}
::-webkit-scrollbar-thumb {
    @apply bg-slate-300 rounded-full;
}
::-webkit-scrollbar-thumb:hover {
    @apply bg-slate-400;
}

/* Selection */
::selection {
    @apply bg-indigo-100 text-indigo-900;
}
